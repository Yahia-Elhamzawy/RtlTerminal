<Window x:Class="RtlTerminal.DirectoryHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RtlTerminal"
        Title="{local:UiText Key='Directory history'}" Width="880" Height="650" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="#F4F5F7" Foreground="#182033"
        FontFamily="Segoe UI" FontSize="13" Icon="/RtlTerminal;component/Assets/RtlTerminal.ico">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{local:UiText Key='Directory history'}" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock x:Name="HistorySummary" Foreground="#697386" Margin="0,6,0,16" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
        <TextBlock Text="{local:UiText Key='Search directories or shells'}" Margin="0,0,0,5"/>
        <TextBox x:Name="SearchBox" Padding="10,8" Margin="0,0,0,14"
                 TextChanged="Search_Changed" ToolTip="{local:UiText Key='Search directories or shell names'}" AutomationProperties.Name="{local:UiText Key='Search directory history'}"/>
        </StackPanel>
        <Grid Grid.Row="2">
            <ListBox x:Name="HistoryList" Background="White" BorderBrush="#DDE1E8" Padding="6"
                     SelectionChanged="History_SelectionChanged" MouseDoubleClick="History_DoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ToolTip="{Binding Details}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="175"/></Grid.ColumnDefinitions>
                            <Path Width="22" Height="18" Stretch="Uniform" VerticalAlignment="Center"
                                  Fill="#E7B14A" Data="M0,3 L0,18 L24,18 L24,5 L11,5 L8,2 L0,2 Z"/>
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Path}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight"/>
                                <TextBlock Text="{Binding Source}" Foreground="#697386" FontSize="12" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{local:UiText Key='Last visited'}" Foreground="#697386" FontSize="11"/>
                                <TextBlock Text="{Binding LastUsed}" Margin="0,4,0,0" FlowDirection="LeftToRight"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyMessage" Text="{local:UiText Key='No directories recorded yet.'}" Foreground="#697386"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,18,0,0">
            <Button x:Name="ClearButton" Content="{local:UiText Key='Clear history'}" Click="Clear_Click" DockPanel.Dock="Left" Margin="0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OpenButton" Content="{local:UiText Key='Open terminal'}" Click="Open_Click" IsEnabled="False"/>
                <Button Content="{local:UiText Key='Close'}" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
