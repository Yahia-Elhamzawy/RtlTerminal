<Window x:Class="RtlTerminal.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RtlTerminal"
        Title="{local:UiText Key='Rtl Terminal update'}"
        Icon="/RtlTerminal;component/Assets/RtlTerminal.ico"
        Width="470"
        Height="255"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#f4f5f7">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{local:UiText Key='A new update is available'}"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="#182033" />

        <StackPanel Grid.Row="1"
                    Margin="0,16,0,12">
            <TextBlock x:Name="VersionTextBlock"
                       FontSize="14"
                       Foreground="#30394d" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="#586174"
                       TextWrapping="Wrap"
                       Text="{local:UiText Key='Open the official GitHub release page to download and install the update.'}" />
        </StackPanel>

        <CheckBox x:Name="DontShowAgainCheckBox"
                  Grid.Row="2"
                  Margin="0,0,0,18"
                  Content="{local:UiText Key='Don\&#x27;t show this update again'}" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="100"
                    Margin="0,0,8,0"
                    Padding="8,6"
                    Content="{local:UiText Key='Not now'}"
                    IsCancel="True"
                    Click="NotNowButton_Click" />
            <Button Width="145"
                    Padding="8,6"
                    Content="{local:UiText Key='Open update page'}"
                    IsDefault="True"
                    Click="OpenUpdateButton_Click" />
        </StackPanel>
    </Grid>
</Window>
